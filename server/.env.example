# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,https://your-portfolio.vercel.app

# Email SMTP Relay (Brevo or Gmail App Password)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# For Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jaydeepjogdand@gmail.com
SMTP_PASS=your_app_password_here

# Recipient email where contact submissions will arrive
RECEIVER_EMAIL=jaydeepjogdand@gmail.com
